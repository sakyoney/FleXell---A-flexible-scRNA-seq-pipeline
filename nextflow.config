/*
========================================================================================
    FleXell — Nextflow Configuration
========================================================================================
*/

params {
    // ===== REQUIRED =====
    input                  = null
    outdir                 = './results'

    // ===== PROTOCOL =====
    protocol               = '10x'        // '10x', 'smartseq2', or 'mixed'

    // ===== GENOME =====
    genome                 = 'GRCh38'     // 'GRCh38', 'GRCm39', or 'custom'
    fasta                  = null
    gtf                    = null
    genome_sa_bases        = 14           // reduce for small genomes/test data

    // ===== 10x / STARsolo =====
    use_cellranger         = false        // false = STARsolo (default), true = Cell Ranger
    starsolo_whitelist     = null         // path to 10x barcode whitelist; null = auto/None
    cb_len                 = 16
    umi_len                = 12           // 10 for v2 chemistry, 12 for v3
    chemistry              = 'auto'
    expect_cells           = 5000
    cellranger_transcriptome = null

    // ===== SMART-SEQ2 =====
    strandedness           = 'unstranded' // 'unstranded', 'forward', 'reverse'
    smartseq_paired        = false        // true if paired-end Smart-seq2

    // ===== QC =====
    min_genes              = 200
    max_genes              = 6000
    min_cells              = 3
    mt_percent_max         = 20
    doublet_detection      = true

    // ===== NORMALIZATION =====
    normalization          = 'seurat'     // 'scran', 'seurat', 'pearson'
    n_top_genes            = 2000
    scale_max_value        = 10

    // ===== BATCH INTEGRATION =====
    integration_method     = 'harmony'   // 'harmony', 'scvi', 'bbknn', 'combat', 'scanorama', 'none'
    batch_key              = 'sample_id'

    // ===== DIMENSIONALITY REDUCTION =====
    n_pcs                  = 30
    n_neighbors            = 15
    min_dist               = 0.3

    // ===== CLUSTERING =====
    clustering_method      = 'leiden'    // 'leiden' or 'louvain'
    resolution             = 0.8

    // ===== MARKER GENES =====
    marker_method          = 'wilcoxon'  // 't-test', 'wilcoxon', 'logreg'
    min_logfc              = 0.5
    marker_pval            = 0.05

    // ===== DIFFERENTIAL EXPRESSION =====
    de_method              = 'wilcoxon'
    de_logfc_threshold     = 0.5
    de_pval_cutoff         = 0.05

    // ===== CELL TYPE ANNOTATION =====
    auto_annotate          = true
    celltypist_model       = 'Immune_All_Low.pkl'

    // ===== RESOURCES =====
    max_cpus               = 16
    max_memory             = '128.GB'
    max_time               = '48.h'

    // ===== MISC =====
    publish_dir_mode       = 'copy'
}

// ===== GENOME REFERENCES (iGenomes S3) =====
params.genomes {
    'GRCh38' {
        fasta = 's3://ngi-igenomes/igenomes/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa'
        gtf   = 's3://ngi-igenomes/igenomes/Homo_sapiens/NCBI/GRCh38/Annotation/Genes/genes.gtf'
    }
    'GRCm39' {
        fasta = 's3://ngi-igenomes/igenomes/Mus_musculus/NCBI/GRCm39/Sequence/WholeGenomeFasta/genome.fa'
        gtf   = 's3://ngi-igenomes/igenomes/Mus_musculus/NCBI/GRCm39/Annotation/Genes/genes.gtf'
    }
}

// ===== EXECUTION PROFILES =====
profiles {

    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        process.container      = 'ghcr.io/sakyoney/flexell:latest'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.container      = 'oras://ghcr.io/sakyoney/flexell:latest'
    }

    conda {
        conda.enabled          = true
        process.conda          = "${projectDir}/environment.yml"
    }

    test {
        params.input           = "${projectDir}/assets/test_samplesheet.csv"
        params.genome          = 'custom'
        params.fasta           = "${projectDir}/assets/test_genome.fa"
        params.gtf             = "${projectDir}/assets/test_genome.gtf"
        params.protocol        = '10x'
        params.expect_cells    = 100
        params.max_cpus        = 4
        params.max_memory      = '16.GB'
        params.max_time        = '2.h'
        params.genome_sa_bases = 11
        params.auto_annotate   = false
        params.integration_method = 'none'
    }

    test_mixed {
        params.input           = "${projectDir}/assets/test_samplesheet_mixed.csv"
        params.genome          = 'custom'
        params.fasta           = "${projectDir}/assets/test_genome.fa"
        params.gtf             = "${projectDir}/assets/test_genome.gtf"
        params.protocol        = 'mixed'
        params.max_cpus        = 4
        params.max_memory      = '16.GB'
        params.auto_annotate   = false
    }
}

// ===== PROCESS RESOURCES =====
process {
    cpus   = { check_max(2 * task.attempt, 'cpus') }
    memory = { check_max(8.GB * task.attempt, 'memory') }
    time   = { check_max(4.h * task.attempt, 'time') }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { check_max(2 * task.attempt, 'cpus') }
        memory = { check_max(8.GB * task.attempt, 'memory') }
        time   = { check_max(4.h * task.attempt, 'time') }
    }
    withLabel: process_medium {
        cpus   = { check_max(6 * task.attempt, 'cpus') }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(8.h * task.attempt, 'time') }
    }
    withLabel: process_high {
        cpus   = { check_max(12 * task.attempt, 'cpus') }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(16.h * task.attempt, 'time') }
    }
    withLabel: process_long {
        time   = { check_max(24.h * task.attempt, 'time') }
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

// ===== MANIFEST =====
manifest {
    name            = 'FleXell'
    author          = 'sakyoney'
    homePage        = 'https://github.com/sakyoney/FleXell---A-flexible-scRNA-seq-pipeline'
    description     = 'Flexible scRNA-seq pipeline: 10x Genomics and Smart-seq2'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

// ===== REPORTING =====
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.svg" }

// ===== RESOURCE CAP HELPER =====
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}
